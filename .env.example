# =============================================================================
# L1 Ingestion Pipeline - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# =============================================================================
# Kafka Configuration
# =============================================================================
KAFKA_BROKERS=localhost:9093
KAFKA_CLIENT_ID=l1-ingestor
KAFKA_TOPIC_RAW=l1.signals.raw
KAFKA_TOPIC_ENRICHED=l1.signals.enriched
KAFKA_TOPIC_FILTERED=l1.signals.filtered
KAFKA_TOPIC_DLQ=l1.signals.dlq

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# GDELT Provider Configuration
# =============================================================================
GDELT_POLL_INTERVAL=15m
GDELT_BATCH_SIZE=250
GDELT_ENABLED=true

# =============================================================================
# FRED Provider Configuration
# =============================================================================
FRED_API_KEY=your_fred_api_key_here
FRED_POLL_INTERVAL=1h
FRED_ENABLED=true
# Series to track (comma-separated)
FRED_SERIES=DFF,T10Y2Y,UNRATE,CPIAUCSL,GDP,FEDFUNDS,MORTGAGE30US,DTWEXBGS

# =============================================================================
# Binance Provider Configuration
# =============================================================================
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_ENABLED=true
# Trading pairs to monitor (comma-separated)
BINANCE_PAIRS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT
# Thresholds for signal generation
BINANCE_LARGE_TRADE_THRESHOLD_USD=1000000
BINANCE_PRICE_CHANGE_THRESHOLD_PCT=2.0
BINANCE_VOLUME_SPIKE_MULTIPLIER=3.0

# =============================================================================
# Whale Alert Provider Configuration
# =============================================================================
WHALEALERT_API_KEY=your_whale_alert_api_key_here
WHALEALERT_ENABLED=true
WHALEALERT_POLL_INTERVAL=1m
WHALEALERT_MIN_VALUE_USD=1000000
# Optional: Filter by blockchains (comma-separated, empty for all)
# WHALEALERT_BLOCKCHAINS=bitcoin,ethereum
# Optional: Filter by transaction types (comma-separated, empty for all)
# WHALEALERT_TRANSACTION_TYPES=transfer,mint,burn

# =============================================================================
# Service Ports
# =============================================================================
GDELT_PORT=8081
FRED_PORT=8082
BINANCE_PORT=8083
WHALEALERT_PORT=8084
COT_PORT=8085
TRADINGECONOMICS_PORT=8086
TELEGRAM_PORT=8087

# =============================================================================
# CME COT Provider Configuration
# =============================================================================
# No API key required - uses public CFTC data
COT_ENABLED=true
COT_POLL_INTERVAL=6h
# Optional: Override default contracts to track
# COT_CONTRACTS=GOLD - COMMODITY EXCHANGE INC.,SILVER - COMMODITY EXCHANGE INC.

# =============================================================================
# Trading Economics Provider Configuration
# =============================================================================
TRADINGECONOMICS_API_KEY=your_trading_economics_api_key_here
TRADINGECONOMICS_ENABLED=true
TRADINGECONOMICS_POLL_INTERVAL=5m
# Optional: Countries to monitor (comma-separated)
# TRADINGECONOMICS_COUNTRIES=united states,china,euro area,japan

# =============================================================================
# Telegram Provider Configuration
# =============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ENABLED=true
TELEGRAM_POLL_INTERVAL=5s
TELEGRAM_POLL_TIMEOUT=30
# Optional: Filter specific chat IDs (comma-separated)
# TELEGRAM_CHAT_IDS=-1001234567890,-1009876543210
# Optional: Custom keywords (comma-separated)
# TELEGRAM_KEYWORDS=breaking,urgent,alert,military,bitcoin

# =============================================================================
# Monitoring Configuration
# =============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json

# =============================================================================
# Snowflake Configuration (for future use)
# =============================================================================
# SNOWFLAKE_ACCOUNT=your_account
# SNOWFLAKE_USER=your_user
# SNOWFLAKE_PASSWORD=your_password
# SNOWFLAKE_DATABASE=ACC_L1
# SNOWFLAKE_SCHEMA=RAW
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# =============================================================================
# SLM Configuration (for future use)
# =============================================================================
# SLM_MODEL_PATH=./models/qwen2-1.5b
# SLM_CONFIDENCE_THRESHOLD=0.7
# SLM_BATCH_SIZE=32
