# =============================================================================
# L1 Ingestion Pipeline - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your API keys
#   docker compose -f deploy/docker-compose.yml up -d
# =============================================================================

# =============================================================================
# Kafka/Redpanda Configuration (internal, usually no changes needed)
# =============================================================================
# These are internal container names - don't change unless you know what you're doing
# KAFKA_BROKERS=redpanda:9092  # Set internally by docker-compose

# =============================================================================
# Provider: GDELT (Geopolitical Events)
# =============================================================================
# No API key required - uses public GDELT data
GDELT_POLL_INTERVAL=15m

# =============================================================================
# Provider: FRED (Federal Reserve Economic Data)
# =============================================================================
# REQUIRED: Get your free API key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here
FRED_POLL_INTERVAL=1h

# =============================================================================
# Provider: Binance (Cryptocurrency Market Data)
# =============================================================================
# No API key required for public market data
BINANCE_PAIRS=BTCUSDT,ETHUSDT
BINANCE_DEPTH_LIMIT=20

# =============================================================================
# Provider: CME COT (Commitment of Traders)
# =============================================================================
# No API key required - uses public CFTC data
COT_POLL_INTERVAL=6h

# =============================================================================
# Provider: Whale Alert (PAID - Deferred)
# =============================================================================
# Uncomment when ready to enable (requires paid API key)
# WHALEALERT_API_KEY=your_whale_alert_api_key_here
# WHALEALERT_POLL_INTERVAL=1m
# WHALEALERT_MIN_VALUE_USD=1000000

# =============================================================================
# Provider: Trading Economics (PAID - Deferred)
# =============================================================================
# Uncomment when ready to enable (requires paid API key)
# TRADINGECONOMICS_API_KEY=your_trading_economics_api_key_here
# TRADINGECONOMICS_POLL_INTERVAL=5m

# =============================================================================
# Telegram Bot (for Alerting)
# =============================================================================
# REQUIRED for alerts: Create bot via @BotFather on Telegram
# 1. Message @BotFather on Telegram
# 2. Send /newbot and follow instructions
# 3. Copy the bot token here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram chat ID for receiving alerts
# To find your chat ID:
# 1. Message your bot
# 2. Go to https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
# 3. Look for "chat":{"id": YOUR_CHAT_ID}
TELEGRAM_CHAT_ID=your_chat_id_here

# Minimum urgency level for alerts: low, medium, high, critical
ALERT_URGENCY_THRESHOLD=high

# =============================================================================
# Monitoring (Grafana)
# =============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# =============================================================================
# Logging
# =============================================================================
# Options: debug, info, warn, error
LOG_LEVEL=info

# =============================================================================
# SLM Worker (Python - for future use)
# =============================================================================
# HuggingFace model for signal enrichment
# SLM_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct

# =============================================================================
# Future: Paid Services (Deferred)
# =============================================================================
# Snowflake (for analytics storage)
# SNOWFLAKE_ACCOUNT=your_account
# SNOWFLAKE_USER=your_user
# SNOWFLAKE_PASSWORD=your_password
# SNOWFLAKE_DATABASE=ACC_L1
# SNOWFLAKE_SCHEMA=RAW
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
